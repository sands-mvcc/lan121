<questestinterop>
  <assessment title="CompTIA Network+ N10-009 Domain 4: Network Security">
    <section>
      <!-- MC Questions -->
      <!-- For brevity, only 2 shown, but all 30 would follow this pattern -->
      <item title="Q1" ident="Q1">
        <presentation>
          <material>
            <mattext>Which technology is used to verify the identity of users before granting network access?</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="A"><material><mattext>Honeynet</mattext></material></response_label>
              <response_label ident="B"><material><mattext>Authentication</mattext></material></response_label>
              <response_label ident="C"><material><mattext>Segmentation</mattext></material></response_label>
              <response_label ident="D"><material><mattext>SCADA</mattext></material></response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <respcondition continue="No">
            <conditionvar><varequal respident="response1">B</varequal></conditionvar>
            <setvar varname="SCORE" action="Set">1</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item title="Q2" ident="Q2">
        <presentation>
          <material>
            <mattext>What does 'least privilege' mean in network security?</mattext>
          </material>
          <response_lid ident="response2" rcardinality="Single">
            <render_choice>
              <response_label ident="A"><material><mattext>Granting users maximum access</mattext></material></response_label>
              <response_label ident="B"><material><mattext>Granting only necessary access</mattext></material></response_label>
              <response_label ident="C"><material><mattext>Allowing all access by default</mattext></material></response_label>
              <response_label ident="D"><material><mattext>Using only physical security</mattext></material></response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <respcondition continue="No">
            <conditionvar><varequal respident="response2">B</varequal></conditionvar>
            <setvar varname="SCORE" action="Set">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Repeat similarly for remaining MC questions (Q3-Q25) -->

      <!-- Multi-Select Example (Q26) -->
      <item title="Q26" ident="Q26">
        <presentation>
          <material>
            <mattext>Which of the following are examples of physical security controls?</mattext>
          </material>
          <response_lid ident="response26" rcardinality="Multiple">
            <render_choice>
              <response_label ident="A"><material><mattext>Cameras</mattext></material></response_label>
              <response_label ident="B"><material><mattext>Encryption</mattext></material></response_label>
              <response_label ident="C"><material><mattext>Locks</mattext></material></response_label>
              <response_label ident="D"><material><mattext>SAML</mattext></material></response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <respcondition continue="Yes">
            <conditionvar>
              <and>
                <varequal respident="response26">A</varequal>
                <varequal respident="response26">C</varequal>
              </and>
            </conditionvar>
            <setvar varname="SCORE" action="Add">1</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <!-- Repeat similarly for Q27-Q30 -->

    </section>
  </assessment>
</questestinterop>
