<?xml version="1.0" encoding="UTF-8"?>
<questestinterop>
  <!-- Multiple Choice Questions -->
  <!-- Q1 -->
  <item title="Documentation Diagram Types" ident="Q1">
    <presentation>
      <material>
        <mattext>Which of the following represents a logical network diagram?</mattext>
      </material>
      <response_lid ident="response1">
        <render_choice>
          <response_label ident="A">
            <material><mattext>A map showing physical cable runs between network hardware</mattext></material>
          </response_label>
          <response_label ident="B">
            <material><mattext>A flowchart showing VLAN segmentation and routing relationships</mattext></material>
          </response_label>
          <response_label ident="C">
            <material><mattext>Rack elevation diagram showing device placements</mattext></material>
          </response_label>
          <response_label ident="D">
            <material><mattext>Table listing warranty expiration dates for switches</mattext></material>
          </response_label>
        </render_choice>
      </response_lid>
    </presentation>
    <resprocessing>
      <respcondition continue="No">
        <conditionvar>
          <varequal respident="response1">B</varequal>
        </conditionvar>
        <setvar action="Set" varname="SCORE">100</setvar>
      </respcondition>
    </resprocessing>
  </item>
  <!-- Q2 -->
  <item title="Asset Inventory" ident="Q2">
    <presentation>
      <material>
        <mattext>Which of the following would NOT be included in an asset inventory?</mattext>
      </material>
      <response_lid ident="response2">
        <render_choice>
          <response_label ident="A"><material><mattext>Device serial numbers</mattext></material></response_label>
          <response_label ident="B"><material><mattext>Software version numbers</mattext></material></response_label>
          <response_label ident="C"><material><mattext>Employee vacation schedules</mattext></material></response_label>
          <response_label ident="D"><material><mattext>License keys</mattext></material></response_label>
        </render_choice>
      </response_lid>
    </presentation>
    <resprocessing>
      <respcondition continue="No">
        <conditionvar>
          <varequal respident="response2">C</varequal>
        </conditionvar>
        <setvar action="Set" varname="SCORE">100</setvar>
      </respcondition>
    </resprocessing>
  </item>
  <!-- Q3 -->
  <item title="Change Management Process" ident="Q3">
    <presentation>
      <material>
        <mattext>What is the purpose of a change management request in network operations?</mattext>
      </material>
      <response_lid ident="response3">
        <render_choice>
          <response_label ident="A"><material><mattext>Documenting cabling topologies</mattext></material></response_label>
          <response_label ident="B"><material><mattext>Recording pending configuration changes for review and approval</mattext></material></response_label>
          <response_label ident="C"><material><mattext>Monitoring live network traffic</mattext></material></response_label>
          <response_label ident="D"><material><mattext>Tracking server patch levels</mattext></material></response_label>
        </render_choice>
      </response_lid>
    </presentation>
    <resprocessing>
      <respcondition continue="No">
        <conditionvar>
          <varequal respident="response3">B</varequal>
        </conditionvar>
        <setvar action="Set" varname="SCORE">100</setvar>
      </respcondition>
    </resprocessing>
  </item>
