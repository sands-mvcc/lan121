          <response_label ident="A"><material><mattext>Primary servers handle DHCP, secondary do not</mattext></material></response_label>
          <response_label ident="B"><material><mattext>Primary servers host the original zone data; secondary are read-only copies</mattext></material></response_label>
          <response_label ident="C"><material><mattext>Secondary servers provide DNSSEC only</mattext></material></response_label>
          <response_label ident="D"><material><mattext>Secondary servers handle IPv6 exclusively</mattext></material></response_label>
