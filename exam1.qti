<?xml version="1.0" encoding="UTF-8"?>
<questestinterop>
  <!-- 1 -->
  <item title="Which layer of the OSI model is responsible for routing?" ident="q1">
    <presentation>
      <material><mattext>Which layer of the OSI model is responsible for routing?</mattext></material>
      <response_lid ident="resp1" rcardinality="Single">
        <render_choice>
          <response_label ident="choiceA"><material><mattext>Physical</mattext></material></response_label>
          <response_label ident="choiceB"><material><mattext>Data Link</mattext></material></response_label>
          <response_label ident="choiceC"><material><mattext>Network</mattext></material></response_label>
          <response_label ident="choiceD"><material><mattext>Transport</mattext></material></response_label>
        </render_choice>
      </response_lid>
    </presentation>
    <resprocessing>
      <respcondition continue="No">
        <conditionvar>
          <varequal respident="resp1">choiceC</varequal>
        </conditionvar>
        <setvar varname="SCORE" action="Set">1</setvar>
      </respcondition>
    </resprocessing>
  </item>
  <!-- 2 -->
  <item title="What device operates primarily at Layer 2 of the OSI model?" ident="q2">
    <presentation>
      <material><mattext>What device operates primarily at Layer 2 of the OSI model?</mattext></material>
      <response_lid ident="resp2" rcardinality="Single">
        <render_choice>
          <response_label ident="choiceA"><material><mattext>Router</mattext></material></response_label>
          <response_label ident="choiceB"><material><mattext>Switch</mattext></material></response_label>
          <response_label ident="choiceC"><material><mattext>Firewall</mattext></material></response_label>
          <response_label ident="choiceD"><material><mattext>Repeater</mattext></material></response_label>
        </render_choice>
      </response_lid>
    </presentation>
    <resprocessing>
      <respcondition continue="No">
        <conditionvar>
          <varequal respident="resp2">choiceB</varequal>
        </conditionvar>
        <setvar varname="SCORE" action="Set">1</setvar>
      </respcondition>
    </resprocessing>
  </item>
