  <!-- 4 -->
  <item title="What is the function of a proxy server?" ident="q4">
    <presentation>
      <material><mattext>What is the function of a proxy server?</mattext></material>
      <response_lid ident="resp4" rcardinality="Single">
        <render_choice>
          <response_label ident="choiceA"><material><mattext>To filter incoming traffic</mattext></material></response_label>
          <response_label ident="choiceB"><material><mattext>To load balance requests</mattext></material></response_label>
          <response_label ident="choiceC"><material><mattext>To act as an intermediary for requests</mattext></material></response_label>
          <response_label ident="choiceD"><material><mattext>To attach storage to the network</mattext></material></response_label>
        </render_choice>
      </response_lid>
    </presentation>
    <resprocessing>
      <respcondition continue="No">
        <conditionvar>
          <varequal respident="resp4">choiceC</varequal>
        </conditionvar>
        <setvar varname="SCORE" action="Set">1</setvar>
      </respcondition>
    </resprocessing>
  </item>
